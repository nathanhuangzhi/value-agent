# Copy to .env (gitignored) and adjust for your machine.
#
# For local dev: use your laptop's LAN IP so a phone on the same Wi-Fi
# can reach the FastAPI server. `localhost` only works for the iOS
# simulator + web; physical devices need the real IP.
#
# Find your IP:  ip addr show | grep "inet "    (Linux)
#                ipconfig getifaddr en0          (macOS Wi-Fi)
EXPO_PUBLIC_API_URL=http://192.168.68.63:8000
