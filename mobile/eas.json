{
  "cli": {
    "version": ">= 13.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://debian-mac-air.tail38ab8e.ts.net/reports"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://debian-mac-air.tail38ab8e.ts.net/reports"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://debian-mac-air.tail38ab8e.ts.net/reports"
      }
    },
    "testflight": {
      "extends": "preview",
      "distribution": "store",
      "channel": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://debian-mac-air.tail38ab8e.ts.net/reports"
      }
    }
  },
  "submit": {
    "production": {},
    "testflight": {
      "ios": {
        "ascAppId": "6772548125",
        "appleTeamId": "6L3BAV63ZA"
      }
    }
  }
}
